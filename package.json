{
  "name": "interview-buddy",
  "version": "0.1.0",
  "description": "Turns a job posting into practice problems and checks your answers on your own computer",
  "type": "module",
  "bin": {
    "interview-buddy": "bin/interview-buddy.js"
  },
  "files": [
    "bin",
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/interview-buddy.js",
    "build": "node build.js",
    "prepare": "npm run build",
    "test": "node --test --test-concurrency=2 \"test/*.test.js\"",
    "coverage": "node --test --test-concurrency=2 --experimental-test-coverage --test-coverage-include=\"src/*.js\" \"test/*.test.js\""
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "dompurify": "^3.5.0",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "marked": "^18.3.0",
    "mathlive": "^0.111.4",
    "preact": "^11.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@excalidraw/mermaid-to-excalidraw": "file:ui/no-mermaid",
    "nanoid": "^3.3.18"
  }
}
